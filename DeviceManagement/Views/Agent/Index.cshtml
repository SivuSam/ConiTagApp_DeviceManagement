@model IEnumerable<Asset>

@{
    ViewData["Title"] = "Assets List";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Adjust if needed
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

<h2 class="my-4"><i class="fa-solid fa-boxes-stacked me-2"></i>Assets List</h2>

<table class="table table-hover table-bordered align-middle">
    <thead class="table-dark">
        <tr>
            <th style="width: 80px;">Picture</th>
            <th>Asset Tag</th>
            <th>Asset Name</th>
            <th>Room</th>
            <th>Condition</th>
            <th>Location</th>
            <th>Verified</th>
            <th>Submitted By</th>
            <th>Submitted Date</th>
            <th style="width: 150px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var asset in Model)
            {
                <tr>
                    <td class="text-center">
                        @if (!string.IsNullOrEmpty(asset.PicturePath))
                        {
                            <img src="@asset.PicturePath" alt="Asset Picture" class="img-thumbnail" style="max-width: 80px; max-height: 80px;" />
                        }
                        else
                        {
                            <span class="text-muted">No Image</span>
                        }
                    </td>
                    <td>@asset.AssetTag</td>
                    <td>@asset.AssetName</td>
                    <td>@asset.Room</td>
                    <td>@asset.Condition</td>
                    <td>@asset.Location</td>
                    <td>
                        @if (asset.Verified == "Y")
                        {
                            <span class="badge bg-success">Yes</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">No</span>
                        }
                    </td>
                    <td>@asset.SubmittedDate.ToString("yyyy-MM-dd HH:mm")</td>
                    
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="10" class="text-center text-muted">No assets found.</td>
            </tr>
        }
    </tbody>
</table>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
