@model DeviceManagement.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="card shadow-lg rounded-4 overflow-hidden">
                <div class="row g-0">
                    <!-- Left side: image or content -->
                    <div class="col-md-5 d-none d-md-block bg-primary text-white p-4 d-flex flex-column justify-content-center">
                        <h2 class="mb-3">Welcome to DeviceManagement</h2>
                        <p class="lead">
                            Join us today and enjoy seamless device leasing services tailored for students and businesses.
                        </p>
                        <p class="small">
                            <em>Launching soon at universities and towns across South Africa.</em>
                        </p>
                    </div>

                    <!-- Right side: form -->
                    <div class="col-md-7 p-5" style="background-color: #f8f9fa;">
                        <h3 class="mb-4 text-center">Create a New Account</h3>

                        <form asp-action="Register" method="post" novalidate>
                            <div class="mb-3">
                                <input asp-for="FullName" class="form-control" placeholder="Full Name" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <input asp-for="Email" class="form-control" placeholder="Email" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <input asp-for="Password" type="password" class="form-control" placeholder="Password" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm Password" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <input asp-for="Address" class="form-control" placeholder="Address" />
                                <span asp-validation-for="Address" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <input asp-for="CellphoneNumber" class="form-control" placeholder="Cellphone Number" />
                                <span asp-validation-for="CellphoneNumber" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <select asp-for="Gender" class="form-select">
                                    <option value="" disabled selected>Select Gender</option>
                                    <option>Male</option>
                                    <option>Female</option>
                                    <option>Other</option>
                                </select>
                                <span asp-validation-for="Gender" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <input asp-for="CompanyName" class="form-control" placeholder="Company Name (if business user)" />
                                <span asp-validation-for="CompanyName" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <input asp-for="StudentNumber" class="form-control" placeholder="Student Number (if student)" />
                                <span asp-validation-for="StudentNumber" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <input asp-for="BusinessNumber" class="form-control" placeholder="Business Number (if registered business)" />
                                <span asp-validation-for="BusinessNumber" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <input asp-for="DateOfBirth" type="date" class="form-control" />
                                <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <input asp-for="SAIdNumber" class="form-control" placeholder="South African ID Number" />
                                <span asp-validation-for="SAIdNumber" class="text-danger small"></span>
                            </div>

                            <button type="submit" class="btn btn-primary w-100">Register</button>

                            <div class="mt-3 text-center">
                                <a asp-action="Login">Already have an account? Login</a>
                            </div>
                        </form>
                    </div> <!-- end right side form -->
                    <div class="mt-4 text-center">
    <p>Or sign up with</p>



    <!-- GitHub Sign-up Button (disabled) -->
    <button type="button" class="btn btn-secondary" style="width: 180px;" disabled>
        <i class="fab fa-github me-2"></i> GitHub (Coming Soon)
    </button>
</div>

                </div> <!-- end row -->
            </div> <!-- end card -->
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
