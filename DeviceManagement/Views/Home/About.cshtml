@{
    ViewData["Title"] = "About Our Asset Management";
}

<div class="container mt-5">
    <div class="text-center mb-4">
        <h2 style="font-weight: bold; color: #007bff;">About Our Asset Management</h2>
        <p style="font-size: 1.1rem; color: #555;">Empowering Efficient Asset Utilization</p>
    </div>

    <div class="row align-items-center mb-5">
        <div class="col-md-6 mb-3 text-center">
            <img src="~/images/assets_overview.png" class="img-fluid rounded" alt="Assets overview image" style="max-height: 300px;" />
        </div>

        <div class="col-md-6">
            <h4 style="color: #343a40;">
                <i class="fas fa-bullseye me-2" style="color: #28a745;"></i>Our Mission
            </h4>
            <p style="font-size: 0.95rem; color: #666;">
                To provide reliable, accessible, and well-maintained assets that support students, businesses, and organizations. We ensure quality asset tracking, management, and protection to maximize value and usability across South Africa.
            </p>

            <h4 style="color: #343a40;">
                <i class="fas fa-lightbulb me-2" style="color: #ffc107;"></i>Our Vision
            </h4>
            <p style="font-size: 0.95rem; color: #666;">
                To be the leading provider of comprehensive asset management solutions, enabling seamless maintenance, lifecycle management, and protection that empowers our clients to focus on their success.
            </p>
        </div>
    </div>

    <div class="row text-center">
        <div class="col-md-4 mb-4">
            <i class="fas fa-boxes fa-3x mb-3" style="color: #007bff;"></i>
            <h5 style="font-weight: bold;">Asset Tracking</h5>
            <p style="color: #666;">
                Efficient asset tracking systems to keep your resources organized and accounted for.
            </p>
        </div>
        <div class="col-md-4 mb-4">
            <i class="fas fa-shield-alt fa-3x mb-3" style="color: #dc3545;"></i>
            <h5 style="font-weight: bold;">Asset Security & Maintenance</h5>
            <p style="color: #666;">
                Comprehensive security measures and maintenance plans to ensure asset longevity and reliability.
            </p>
        </div>
        <div class="col-md-4 mb-4">
            <i class="fas fa-chart-line fa-3x mb-3" style="color: #28a745;"></i>
            <h5 style="font-weight: bold;">Community Impact</h5>
            <p style="color: #666;">
                Driving growth and technological empowerment by optimizing asset use and reinvestment in communities.
            </p>
        </div>
    </div>
</div>

<!-- Include Bootstrap and FontAwesome CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
