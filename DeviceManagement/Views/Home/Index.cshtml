@{
    ViewData["Title"] = "Welcome to Holding Tech SA";
}

<!-- Hero Section -->
<section class="text-white text-center" style="background: linear-gradient(135deg, #003366, #0059b3); padding: 80px 20px;">
    <div class="container">
        <h1 class="display-4 fw-bold">Efficient Asset Management for the Digital Age</h1>
        <p class="lead">Empowering businesses and individuals across South Africa to manage, track, and optimize their tech assets.</p>
        <a href="/Asset/Index" class="btn btn-light btn-lg mt-3">Manage Your Assets <i class="fas fa-boxes"></i></a>
    </div>
</section>

<!-- Features -->
<section class="py-5 bg-light text-center">
    <div class="container">
        <h2 class="mb-4">Our Core Services</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <i class="fas fa-laptop-code fa-3x text-primary mb-3"></i>
                        <h5 class="card-title">Tech Asset Tracking</h5>
                        <p class="card-text">Monitor and manage your laptops, desktops, and mobile devices in real time from a central platform.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <i class="fas fa-sync-alt fa-3x text-success mb-3"></i>
                        <h5 class="card-title">Lifecycle Management</h5>
                        <p class="card-text">From procurement to disposal, track the full lifecycle of every asset for better planning and budgeting.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-body">
                        <i class="fas fa-shield-alt fa-3x text-danger mb-3"></i>
                        <h5 class="card-title">Compliance & Protection</h5>
                        <p class="card-text">Ensure your IT assets are protected and compliant with local laws and internal policies.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Call to Action -->
<section class="py-5 text-white text-center" style="background: #0059b3;">
    <div class="container">
        <h3 class="mb-3">Own or Manage IT Equipment?</h3>
        <p>Partner with us to streamline your asset management and gain full control over your technology investments.</p>
        <a href="" class="btn btn-outline-light btn-lg">Start Managing Assets (Coming Soon)</a>
    </div>
</section>

<!-- Footer -->
<footer class="bg-dark text-white text-center py-4">
    <div class="container">
        <p class="mb-1">&copy; 2025 Holding Tech SA. All rights reserved.</p>
        <small>Built with <i class="fas fa-heart text-danger"></i> in South Africa</small>
    </div>
</footer>
