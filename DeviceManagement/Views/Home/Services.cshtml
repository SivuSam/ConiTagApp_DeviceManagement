@{
    ViewData["Title"] = "Services";
}

<div class="container mt-5">
    <h2 class="text-center mb-5">
        Our <span style="color: #007bff;">Asset Management Services</span>
    </h2>

    <div class="row row-cols-1 row-cols-md-2 g-4">
        <!-- Asset Tracking -->
        <div class="col">
            <div class="card h-100"
                 style="transition: transform 0.3s ease, box-shadow 0.3s ease; border-radius: 15px; border: none;"
                 onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 8px 20px rgba(0, 0, 0, 0.15)';"
                 onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none';">
                <div class="card-body text-center">
                    <i class="fas fa-boxes fa-3x mb-3" style="color: #007bff;"></i>
                    <h5 class="card-title" style="font-weight: 600; margin-bottom: 10px;">Asset Tracking</h5>
                    <p class="card-text" style="font-size: 0.95rem; color: #666;">
                        Keep accurate records of all your assets with our efficient tracking system.
                    </p>
                </div>
            </div>
        </div>

        <!-- Asset Maintenance -->
        <div class="col">
            <div class="card h-100"
                 style="transition: transform 0.3s ease, box-shadow 0.3s ease; border-radius: 15px; border: none;"
                 onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 8px 20px rgba(0, 0, 0, 0.15)';"
                 onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none';">
                <div class="card-body text-center">
                    <i class="fas fa-tools fa-3x mb-3" style="color: #28a745;"></i>
                    <h5 class="card-title" style="font-weight: 600; margin-bottom: 10px;">Asset Maintenance</h5>
                    <p class="card-text" style="font-size: 0.95rem; color: #666;">
                        Comprehensive maintenance services to prolong the life and performance of your assets.
                    </p>
                </div>
            </div>
        </div>

       

        <!-- Asset Analytics -->
        <div class="col">
            <div class="card h-100"
                 style="transition: transform 0.3s ease, box-shadow 0.3s ease; border-radius: 15px; border: none;"
                 onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 8px 20px rgba(0, 0, 0, 0.15)';"
                 onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='none';">
                <div class="card-body text-center">
                    <i class="fas fa-chart-line fa-3x mb-3" style="color: #ffc107;"></i>
                    <h5 class="card-title" style="font-weight: 600; margin-bottom: 10px;">Asset Analytics</h5>
                    <p class="card-text" style="font-size: 0.95rem; color: #666;">
                        Gain insights and optimize your asset usage with our advanced analytics tools.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
